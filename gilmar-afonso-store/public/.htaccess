# Hospedagem Apache/FTP (cPanel, Hostinger, Locaweb...).
# Sem isto, abrir /produto/polo-classica-bordo direto no navegador daria erro 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
